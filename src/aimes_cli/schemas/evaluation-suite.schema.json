{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIMES Evaluation Suite",
  "type": "object",
  "required": ["schema_version", "suite_id", "version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "objective", "input", "expected", "scoring"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "objective": {"type": "string"},
          "input": {"type": "object"},
          "expected": {"type": "object"},
          "scoring": {
            "type": "object",
            "properties": {
              "hard_gates": {"type": "array"},
              "diagnostic_dimensions": {"type": "array"}
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
