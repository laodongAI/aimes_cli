{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimes.local/schemas/reuse-decision.schema.json",
  "title": "AIMES Reuse Decision",
  "type": "object",
  "required": ["schema_version", "reuse_decision_id", "task_id", "status", "candidate_assets", "comparison", "decision", "rationale", "verification_plan"],
  "properties": {
    "schema_version": {"const": 1}, "reuse_decision_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "status": {"enum": ["DRAFT", "APPROVED", "PLANNED", "IN_PROGRESS", "IMPLEMENTED_UNVERIFIED", "VERIFIED", "FAILED", "BLOCKED", "REJECTED", "DEPRECATED", "REMOVED", "UNKNOWN", "NOT_APPLICABLE"]}, "candidate_assets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["asset_ref"]}}, "comparison": {"type": "object"}, "decision": {"enum": ["REUSE", "ADAPT", "TRANSFER_PATTERN", "DO_NOT_REUSE", "NEED_MORE_EVIDENCE"]}, "rationale": {"type": "string", "minLength": 1}, "planned_adaptations": {"type": "array"}, "rejected_alternatives": {"type": "array"}, "verification_plan": {"type": "array", "minItems": 1}, "verification_evidence": {"type": "array"}, "approval_required": {"type": "boolean"}, "approved_by": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
