{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laodongAI/aimes_cli/blob/main/schemas/skill-execution-record.schema.json",
  "title": "AIMES Skill Execution Record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "skill_id",
    "skill_version",
    "registry_version",
    "task_id",
    "baseline_commit",
    "tool_id",
    "tool_version",
    "execution_mode",
    "aimes_cli_version",
    "governance_version",
    "started_at",
    "status",
    "steps",
    "acceptance_checks",
    "outputs",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string"
    },
    "baseline_commit": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "enum": [
        "trae-code",
        "vscode-codex",
        "vscode-claude-code",
        "vscode-copilot",
        "zcode",
        "qcode",
        "claude-code",
        "codex-cli"
      ]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "ide_extension",
        "cli",
        "desktop_app",
        "other"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "aimes_cli_version": {
      "type": "string",
      "minLength": 1
    },
    "governance_version": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "CANCELLED",
        "UNKNOWN",
        "IN_PROGRESS"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "name",
          "status"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "SKIPPED",
              "FAILED",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "skip_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SKIPPED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "skip_reason"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "criterion",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "source",
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "tool_report",
            "provider_report",
            "unavailable"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "finished_at"
        ],
        "properties": {
          "steps": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "COMPLETED",
                    "SKIPPED"
                  ]
                }
              }
            }
          },
          "acceptance_checks": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          },
          "outputs": {
            "minItems": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
