{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIMES Temporary Artifact Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "purpose",
          "classification",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "owner_task_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "classification": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "KEEP",
              "CLEANUP_CANDIDATE",
              "REMOVED"
            ]
          }
        }
      }
    }
  }
}
