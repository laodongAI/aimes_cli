{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laodongAI/aimes_cli/blob/main/schemas/adapter-registry.schema.json",
  "title": "AIMES Host and Harness Adapter Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "registry_version", "capability_states", "adapters"],
  "properties": {
    "schema_version": {"const": 2},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capability_states": {"type": "array", "uniqueItems": true, "items": {"enum": ["native", "template", "manual", "unknown", "unsupported"]}},
    "adapters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "host", "harness", "execution_modes", "entry_paths", "capabilities", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["template", "manual"]},
          "detection_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "host": {"type": "object", "required": ["id", "type", "name"], "properties": {"id": {"type": "string"}, "type": {"enum": ["ide", "cli", "hosted_workspace", "desktop_app"]}, "name": {"type": "string"}},"additionalProperties": false},
          "harness": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}},"additionalProperties": false},
          "execution_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ide_extension", "cli", "desktop_app", "workspace", "unknown"]}},
          "entry_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "capabilities": {"type": "object", "additionalProperties": {"enum": ["native", "template", "manual", "unknown", "unsupported"]}},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
