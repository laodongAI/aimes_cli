{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laodongAI/aimes_cli/blob/main/schemas/workflow-run.schema.json",
  "title": "AIMES Workflow Run Record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workflow_id",
    "workflow_version",
    "definition_sha256",
    "task_id",
    "baseline_commit",
    "current_state",
    "status",
    "attempts",
    "history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_commit": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "SUCCESS",
        "FAILURE",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "attempts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event",
          "from",
          "to",
          "timestamp",
          "actor",
          "evidence_refs"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_ref": {
            "type": "string"
          },
          "guard_evidence": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "backup_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
